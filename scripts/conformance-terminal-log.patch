+async def get_terminal_test_log(conformance, module, module_id, info):
+    logs = await conformance.get_test_log(module_id)
+    if module != 'oidcc-server-rotate-keys' or (info.get('status'), info.get('result')) != ('FINISHED', 'FAILED'):
+        return logs
+    # The suite can expose the terminal state before all condition logs are readable.
+    # Refresh this module only. The original analyzer still requires every expected condition.
+    try:
+        async with asyncio.timeout(2):
+            for _ in range(5):
+                if any(entry.get('result') == 'FAILURE' for entry in logs):
+                    break
+                await asyncio.sleep(0.2)
+                logs = await conformance.get_test_log(module_id)
+    except TimeoutError:
+        pass
+    return logs
